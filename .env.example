# PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/customer_intelligence

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
MODEL_ARTIFACTS_DIR=models_artifacts
DATA_DIR=data/raw

# Financial Assumptions for CLV & ROI Simulator (Defaults)
DEFAULT_CONTRIBUTION_MARGIN=0.65
DEFAULT_ANNUAL_DISCOUNT_RATE=0.10
DEFAULT_HORIZON_MONTHS=24
